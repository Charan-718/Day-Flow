NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://dayflow:dayflow@localhost:5433/dayflow?schema=public
JWT_SECRET=local-dev-only-change-in-production-min-32-chars!!
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
LATE_CHECKIN_THRESHOLD=10:30
COMPANY_NAME=Dayflow
COMPANY_CODE=DF
BOOTSTRAP_HR_EMAIL=hr.admin@yourcompany.com
BOOTSTRAP_HR_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_HR_FIRST_NAME=HR
BOOTSTRAP_HR_LAST_NAME=Administrator
RUN_SEED_ON_START=false
# When true, `npm run prisma:seed` also builds a full realistic demo organisation
# (~30 employees across 8 departments, with photos, attendance and leave history) — see
# prisma/seed.ts. Every seeded employee shares DEMO_SEED_PASSWORD.
SEED_DEMO_DATA=true
DEMO_SEED_PASSWORD=Password@123
