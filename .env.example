# ─── PostgreSQL (Docker + local) ───
POSTGRES_USER=dayflow
POSTGRES_PASSWORD=dayflow
POSTGRES_DB=dayflow
POSTGRES_PORT=5433

# ─── Backend API ───
NODE_ENV=production
PORT=4000
JWT_SECRET=dayflow-local-docker-jwt-secret-min-32-chars
JWT_EXPIRES_IN=2h
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12
LATE_CHECKIN_THRESHOLD=10:30

# ─── Company (Login ID prefix) ───
COMPANY_NAME=Dayflow
COMPANY_CODE=DF

# ─── First-time bootstrap (creates ONE HR admin if no users exist) ───
BOOTSTRAP_HR_EMAIL=hr.admin@dayflow.local
BOOTSTRAP_HR_PASSWORD=ChangeMeOnFirstLogin!
BOOTSTRAP_HR_FIRST_NAME=HR
BOOTSTRAP_HR_LAST_NAME=Administrator

# ─── Seed behaviour ───
RUN_SEED_ON_START=true
# true = demo users (priya@demo.local / rahul@demo.local, Password@123)
SEED_DEMO_DATA=true

# ─── Frontend build (Docker) ───
VITE_API_URL=/api
